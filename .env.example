# ============================================================
#  Dreams Interpreter — Environment Variables
# ============================================================

# --- Database (libSQL / Turso) ---
# Local development: leave as a local file.
#   DATABASE_URL="file:local.db"
# Production (free Turso DB — https://turso.tech):
#   DATABASE_URL="libsql://your-db-name.turso.io"
#   DATABASE_AUTH_TOKEN="your-turso-auth-token"
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# --- Auth ---
# A long random secret used to sign session JWTs.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# --- AI provider (OpenAI-compatible / provider-agnostic) ---
# Works with OpenAI, Groq, OpenRouter, Together, local LLMs, etc.
# Just point AI_BASE_URL + AI_MODEL to whichever provider you use.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Examples:
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1            AI_MODEL=gpt-4o-mini
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1       AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1         AI_MODEL=openai/gpt-4o-mini
