# ============================================================
#  Dreams Interpreter — Environment Variables
# ============================================================

# --- Database (libSQL / Turso) ---
# Local development: leave as a local file.
#   DATABASE_URL="file:local.db"
# Production (free Turso DB — https://turso.tech):
#   DATABASE_URL="libsql://your-db-name.turso.io"
#   DATABASE_AUTH_TOKEN="your-turso-auth-token"
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# --- Auth ---
# A long random secret used to sign session JWTs.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# --- AI provider (OpenAI-compatible / provider-agnostic) ---
# Works with OpenAI, Groq, OpenRouter, Together, local LLMs, etc.
# Just point AI_BASE_URL + AI_MODEL to whichever provider you use.
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL accepts a comma-separated fallback chain — handy for free OpenRouter
# models that get rate-limited (429); the next one is tried automatically.
AI_MODEL="deepseek/deepseek-v4-flash-0731:free,inclusionai/ling-3.0-flash-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free"

# Optional tuning:
# Max output tokens per reply (raise for long, reasoned interpretations).
AI_MAX_TOKENS="1500"
# Set to "true" for OpenRouter "reasoning" models (e.g. GLM/DeepSeek free
# tiers) that otherwise spend the whole budget thinking and return empty text.
AI_DISABLE_REASONING="false"

# Semantic RAG (hybrid lexical + meaning). ON BY DEFAULT when AI_BASE_URL points
# at OpenRouter: it falls back to the free nvidia/llama-nemotron-embed-vl-1b-v2
# (2048-dim, matches src/data/kb-vectors.json). Leave this unset to keep that.
#   - set a model id to use a different one, e.g. "text-embedding-3-small"
#   - set "off" to disable and keep ALL retrieval local (see privacy note below)
# Privacy: when enabled, the dream text is sent to the embeddings provider.
# Rebuild vectors after changing the model or the corpus:
#   node scripts/build-embeddings.mjs && node scripts/quantize-embeddings.mjs
# AI_EMBED_MODEL="off"
# How long to wait for the embeddings call before interpreting without it.
# AI_EMBED_TIMEOUT_MS="5000"

# Examples:
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1            AI_MODEL=gpt-4o-mini
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1       AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1         AI_MODEL=deepseek/deepseek-v4-flash-0731:free,inclusionai/ling-3.0-flash-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Comma-separated admin emails. Any account with one of these emails sees the
# /admin panel (view + manage all users and dreams).
# ADMIN_EMAILS="you@example.com"
