# ============================================================
#  Dreams Interpreter — Environment Variables
# ============================================================

# --- Database (libSQL / Turso) ---
# Local development: leave as a local file.
#   DATABASE_URL="file:local.db"
# Production (free Turso DB — https://turso.tech):
#   DATABASE_URL="libsql://your-db-name.turso.io"
#   DATABASE_AUTH_TOKEN="your-turso-auth-token"
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# --- Auth ---
# A long random secret used to sign session JWTs.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-string"

# --- AI provider (OpenAI-compatible / provider-agnostic) ---
# Works with OpenAI, Groq, OpenRouter, Together, local LLMs, etc.
# Just point AI_BASE_URL + AI_MODEL to whichever provider you use.
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL accepts a comma-separated fallback chain — handy for free OpenRouter
# models that get rate-limited (429); the next one is tried automatically.
AI_MODEL="google/gemma-4-31b-it:free,moonshotai/kimi-k2.6:free,meta-llama/llama-3.3-70b-instruct:free"

# Optional tuning:
# Max output tokens per reply (raise for long, reasoned interpretations).
AI_MAX_TOKENS="1500"
# Set to "true" for OpenRouter "reasoning" models (e.g. GLM/DeepSeek free
# tiers) that otherwise spend the whole budget thinking and return empty text.
AI_DISABLE_REASONING="false"

# Optional semantic RAG: an embeddings model id. When set AND
# src/data/kb-vectors.json exists, retrieval becomes hybrid (lexical + meaning).
# Build vectors with: node scripts/build-embeddings.mjs && node scripts/quantize-embeddings.mjs
# AI_EMBED_MODEL="text-embedding-3-small"
# AI_EMBED_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2:free"  (OpenRouter free; needs privacy opt-in)

# Examples:
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1            AI_MODEL=gpt-4o-mini
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1       AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1         AI_MODEL=google/gemma-4-31b-it:free

# Comma-separated admin emails. Any account with one of these emails sees the
# /admin panel (view + manage all users and dreams).
# ADMIN_EMAILS="you@example.com"
